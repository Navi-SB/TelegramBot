# Copy to .env for local development (scripts/dev_poll.py reads the real env).
# In production these are Vercel project environment variables.

# From @BotFather. Use a SEPARATE @..._dev_bot for Preview and Development:
# setWebhook is global to a bot, so a preview deploy would otherwise steal the
# production webhook on any branch push.
TELEGRAM_BOT_TOKEN=

# python -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# HMAC key for the webhook -> worker hand-off. Without it /api/worker is a
# public endpoint that sends Telegram messages for anyone who guesses a shape.
# python -c "import secrets;print(secrets.token_urlsafe(32))"
BOT_INTERNAL_SECRET=

# This deployment's PUBLIC URL. Set it explicitly — do NOT derive it from
# VERCEL_URL, which is the per-deployment URL that Deployment Protection covers
# and Telegram would 401 against.
BOT_SELF_URL=https://tgbot.tropishq.com

VOYAGECALC_API_BASE=https://tropishq.com

# The RAW service token. Its sha256 goes in VoyageCalc's
# VOYAGECALC_SERVICE_TOKEN_HASHES. Generate both with:
#   python -c "import hashlib,secrets;t=secrets.token_urlsafe(32);print('raw :',t);print('hash:',hashlib.sha256(t.encode()).hexdigest())"
VOYAGECALC_SERVICE_TOKEN=

# Must match vercel.json's maxDuration for api/worker.py; the in-code deadline
# is derived from it so the bot gives up with a message before the platform
# cuts it off mid-turn.
BOT_MAX_DURATION=290

# Optional: chat id to ping on unhandled exceptions.
BOT_ADMIN_CHAT_ID=

# Optional safety net: the last few characters of the PRODUCTION bot token.
# A non-production deploy holding a token ending in this refuses to start.
TELEGRAM_PROD_BOT_TOKEN_SUFFIX=

# --- WhatsApp (Meta Cloud API) ------------------------------------------------
# All optional: a Telegram-only deployment runs without them. The /api/whatsapp
# webhook and /api/wa_worker require the four non-optional ones below.

# Permanent System User token (whatsapp_business_messaging +
# whatsapp_business_management). The dashboard's temporary token dies in ~24h.
WHATSAPP_ACCESS_TOKEN=

# The numeric Graph id of the SENDING number (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# Self-minted, for Meta's GET webhook handshake:
# python -c "import secrets;print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=

# Meta App Secret (App Settings → Basic) — keys X-Hub-Signature-256. This is
# NOT the verify token.
WHATSAPP_APP_SECRET=

# Optional: WABA id, only needed by scripts/wa_subscribe.py.
WHATSAPP_WABA_ID=

# Optional: Graph API version override.
WHATSAPP_GRAPH_VERSION=v26.0

# Optional safety net: the PRODUCTION phone_number_id. A non-production deploy
# holding this number refuses to start (a preview sending from the production
# number is the WhatsApp analogue of a preview stealing the webhook).
WHATSAPP_PROD_PHONE_NUMBER_ID=
